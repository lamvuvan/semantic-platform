# ─────────────────────────────────────────────────────────────────────────────
# .dockerignore — global, áp dụng cho mọi build context.
# Mục tiêu: build context nhỏ, không leak secrets, image determinstic.
# Mỗi Dockerfile (mcp/api/loaders) đã COPY chọn lọc, file này chống nhiễu.
# ─────────────────────────────────────────────────────────────────────────────

# Git
.git/
.gitignore
.gitattributes
.github/
.gitlab/
.gitlab-ci.yml

# CI scripts (chỉ chạy trong runner, không cần trong image)
ci/

# Docs (không cần runtime)
docs/
*.md
!README.md

# IaC — chạy ngoài image
infra/ansible/
infra/inventory/

# ─────────────────────────────────────────────────────────────────────────────
# Components không liên quan đến runtime container
# ─────────────────────────────────────────────────────────────────────────────
# Airflow DAGs đóng gói riêng vào worker image (mount từ git sync), không vào MCP/API
airflow/

# Spark/dbt — chạy trên cluster Spark, không vào MCP/API image
transforms/

# Tests + fixtures + eval (CI dùng từ checkout, không nướng vào prod image)
tests/
eval/

# Notebook
*.ipynb
.ipynb_checkpoints/

# ─────────────────────────────────────────────────────────────────────────────
# Python build/cache artifacts
# ─────────────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
build/
dist/
*.egg-info/
*.egg
.eggs/
wheels/

# Test / lint / type caches
.pytest_cache/
.cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
.tox/
.nox/
.hypothesis/
.mypy_cache/
.ruff_cache/
.pyright/
.pip/

# Virtual envs (không bao giờ COPY vào image)
.venv/
venv/
env/
ENV/

# ─────────────────────────────────────────────────────────────────────────────
# Secrets — phòng ngừa dù COPY chọn lọc
# ─────────────────────────────────────────────────────────────────────────────
.env
.env.*
!.env.example
!.env.sample
*.pem
*.key
*.crt
*.p12
secrets/
.secrets/
*.kubeconfig
.kube/
*.vault
infra/ansible/.vault-pass*

# ─────────────────────────────────────────────────────────────────────────────
# dbt / Airflow / Spark artifacts cục bộ
# ─────────────────────────────────────────────────────────────────────────────
target/
dbt_packages/
**/target/
**/dbt_packages/
spark-warehouse/
metastore_db/
derby.log
airflow/logs/
airflow/airflow.db
airflow/airflow.cfg

# ─────────────────────────────────────────────────────────────────────────────
# Local data
# ─────────────────────────────────────────────────────────────────────────────
*.parquet
*.csv.gz
*.tar.gz
*.dump
*.bak
neo4j-data/
neo4j-logs/
data/
scratch/
tmp/

# ─────────────────────────────────────────────────────────────────────────────
# Logs
# ─────────────────────────────────────────────────────────────────────────────
logs/
*.log
*.log.*

# ─────────────────────────────────────────────────────────────────────────────
# Security scan reports
# ─────────────────────────────────────────────────────────────────────────────
trivy-report.*
semgrep-report.*
bandit-report.*
sbom.json
sbom.xml

# ─────────────────────────────────────────────────────────────────────────────
# IDE & editor
# ─────────────────────────────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
*~

# ─────────────────────────────────────────────────────────────────────────────
# OS
# ─────────────────────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
Thumbs.db
Desktop.ini

# ─────────────────────────────────────────────────────────────────────────────
# Node (nếu có frontend nội bộ build chung)
# ─────────────────────────────────────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*

# ─────────────────────────────────────────────────────────────────────────────
# Docker (tránh recursion build context)
# ─────────────────────────────────────────────────────────────────────────────
.docker/
docker-compose.override.yml
docker-compose.*.local.yml
Dockerfile*
!infra/docker/*/Dockerfile
.dockerignore
